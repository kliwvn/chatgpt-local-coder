{
  "name": "chatgpt-local-coder",
  "version": "1.0.0",
  "description": "Turn ChatGPT web into a local coding agent via MCP — files, shell, git, apply_patch, 40+ tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/kliwvn/chatgpt-local-coder.git"
  },
  "homepage": "https://github.com/kliwvn/chatgpt-local-coder#readme",
  "bugs": {
    "url": "https://github.com/kliwvn/chatgpt-local-coder/issues"
  },
  "author": "kliwvn",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "codex-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "node scripts/build-windows-sandbox-helper.mjs && tsc",
    "setup:sandbox": "node scripts/setup-windows-sandbox.mjs",
    "test": "node scripts/run-all-tests.mjs",
    "runtime:tunnel": "node scripts/ensure-tunnel-client-lazy-codex.mjs",
    "test:all": "node scripts/run-all-tests.mjs",
    "test:integration": "npm run build && node scripts/test-mcp-bridge-integration.mjs",
    "init-claude-md": "node scripts/init-claude-md.mjs",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:3000"
  },
  "keywords": [
    "mcp",
    "chatgpt",
    "coding-agent",
    "model-context-protocol",
    "local-development",
    "filesystem",
    "git",
    "apply-patch",
    "developer-mode",
    "openai-tunnel"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22"
  }
}
