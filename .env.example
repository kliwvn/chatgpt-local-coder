PORT=3000
MANAGER_PORT=3300

# Thu muc PROJECT cua ban — giong khi chay `claude` trong thu muc do.
# ChatGPT doc CLAUDE.md/AGENTS.md tu day vao moi session (nhu Claude Code).
# KHONG de thu muc codex-mcp-server — dat dung repo ban dang lam (vd D:\Coding\my-app).
WORKSPACE_PATH=C:\Users\YourName\projects\my-app

# Path boundary: false = path-aware tools chi truy cap cac workspace roots.
# run_command/start_process la native shell, KHONG phai OS sandbox boi setting nay.
# Dat true = path-aware tools duoc phep dung path toan may.
FULL_DISK_ACCESS=false

# Them project khac (phan cach bang ; tren Windows)
# EXTRA_WORKSPACE_PATHS=D:\Coding\other-repo

# Aliases cua EXTRA_WORKSPACE_PATHS (doc them neu co)
# WORKSPACE_PATHS=D:\Coding\another-repo
# ALLOWED_WORKSPACE_PATHS=D:\Coding\more-repos

# slim = ~25 tools cho ChatGPT web (mac dinh, tot nhat). full = tat ca tools.
CHATGPT_TOOL_PROFILE=slim

# Post-edit hooks (php -l, node --check sau khi sua file)
# POST_EDIT_HOOKS_CONFIG=profiles/post-edit-hooks.json

# Shell cwd luu giua cac tool call ChatGPT
# MCP_SHELL_STATE_DIR=.mcp-state

# Gioi han noi dung CLAUDE.md inject vao MCP instructions (mac dinh ~25KB)
PROJECT_MEMORY_MAX_BYTES=25000
PROJECT_MEMORY_MAX_LINES=200

# Recent cross-session auto-memory. File duoc compact de giu note moi nhat.
AUTO_MEMORY_MAX_BYTES=25000
AUTO_MEMORY_MAX_LINES=200

# User memory (tu dong load neu ton tai):
#   %USERPROFILE%\.codex\CLAUDE.md  hoac  %USERPROFILE%\.claude\CLAUDE.md

# Giam popup xac nhan tool tren ChatGPT
CHATGPT_AUTO_APPROVE=true

SHELL_TIMEOUT=120

# Hard deadline budget for synchronous MCP work. Keep this below the external
# tunnel/request deadline; long-running jobs should use start_process instead.
MCP_SYNC_RESPONSE_BUDGET_MS=100000

# Background processes started by start_process are shared across MCP sessions,
# bounded in RAM, and terminated when the Gateway shuts down/restarts.
PROCESS_MAX_RUNNING=16
PROCESS_HISTORY_MAX=32
PROCESS_LOG_MAX_CHARS=200000

# Bound foreground shell/git output in RAM. Tool results also keep a conservative
# wire budget below the OpenAI Secure MCP Tunnel 10 MiB request/response limit.
SHELL_OUTPUT_MAX_CHARS=250000
GIT_OUTPUT_MAX_CHARS=500000
READ_TEXT_MAX_BYTES=2097152
EDIT_TEXT_MAX_BYTES=5242880
READ_BASE64_MAX_BYTES=2097152
MCP_TOOL_RESULT_MAX_BYTES=7340032
MCP_TOOL_RESULT_TEXT_DUPLICATE_MAX_BYTES=131072

# Checkpoint / rewind (Claude Code-style code undo)
CHECKPOINT_ENABLED=true
CHECKPOINT_PATH=.mcp-checkpoints
CHECKPOINT_MAX_COUNT=500
CHECKPOINT_RETENTION_DAYS=30
CHECKPOINT_MAX_FILE_BYTES=5242880
CHECKPOINT_MAX_TOTAL_BYTES=33554432
CHECKPOINT_MAX_NODES=10000

# Audit/activity diagnostics. Managed instances resolve a relative audit path
# inside manager/instances/<name>/ and rotate it before it grows unbounded.
AUDIT_LOG_PATH=.mcp-audit.log
AUDIT_LOG_MAX_BYTES=10485760
ACTIVITY_LOG_MAX=500

# Admin GUI (localhost-only)
ADMIN_PORT=3001
ADMIN_TOKEN=

# Upstream MCP hub config
MCP_UPSTREAM_CONFIG=profiles/mcp-upstream.json

# MCP session stability. Stale-session recovery is automatic; no user-facing switch.
# ChatGPT co the tao session transport moi rat thuong xuyen (gan 1/tool call).
MCP_SESSION_TTL_MS=120000
MCP_SESSION_CLEANUP_MS=15000
# Fallback only for transport-close paths outside an explicit serialized DELETE.
# Explicit DELETE waits for earlier POST/tool calls, then disposes immediately.
MCP_SESSION_DELETE_GRACE_MS=45000
MCP_MAX_SESSIONS=64

# OpenAI Secure MCP Tunnel (URL on dinh — chay openai-tunnel-init.bat lan dau)
# Lay tu: https://platform.openai.com/settings/organization/tunnels
# API key: https://platform.openai.com/settings/organization/api-keys (Runtime key)
OPENAI_TUNNEL_ID=
OPENAI_TUNNEL_API_KEY=